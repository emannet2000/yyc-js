# Start with: node --env-file=.env server/start.js
# Obtain your own openrouteservice credential. Never put it in frontend code.
ORS_API_KEY=
# driving-hgv provides a truck route profile; dimensions/hazmat are not configured.
ORS_PROFILE=driving-hgv
# Optional, defaults to the hosted service:
# ORS_BASE_URL=https://api.openrouteservice.org
# Required for publicly shared recipient links and Android pairing:
PUBLIC_ORIGIN=https://deliveries.example.com
COOKIE_SECURE=true
HOST=127.0.0.1
PORT=3000
# Alternative to ORS: your OSRM-compatible and Nominatim-compatible endpoints:
# ROUTING_URL=https://router.example.com
# GEOCODING_URL=https://geocoder.example.com/search
# ROUTING_TOKEN=
